          "verify_ssl": "Leave off for the console's default self-signed certificate."
        }
      },
      "reauth_confirm": {
        "title": "Re-enter Protect credentials",
        "data": { "username": "Username", "password": "Password" }
      },
      "reconfigure": {
        "title": "Change the Protect connection",
        "data": {
          "host": "Host",
          "port": "Port",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the console.",
      "invalid_auth": "The console rejected the username or password.",
      "unknown": "Unexpected error; check the logs."
    },
    "abort": {
      "already_configured": "This console is already configured.",
      "reauth_successful": "Credentials updated.",
      "reconfigure_successful": "Connection updated.",
      "wrong_console": "That address belongs to a different console."
    }
  },
  "entity": {
    "binary_sensor": {
      "air_quality_alert": { "name": "Air quality alert" },
