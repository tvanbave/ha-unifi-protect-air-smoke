        "name": "Maintenance",
        "state_attributes": {
          "event_type": {
            "state": {
              "self_test": "Self-test",
              "battery_low": "Battery low",
              "needs_cleaning": "Needs cleaning",
              "smoke_fault": "Smoke sensor fault",
              "co_fault": "CO sensor fault",
              "end_of_life": "End of life"
            }
          }
        }
      },
      "air_alert_event": {
        "name": "Air quality event",
        "state_attributes": {
          "event_type": {
            "state": { "extreme": "Threshold exceeded", "vape": "Vape detected" }
          }
        }
      }
    },
    "sensor": {
      "tvoc": { "name": "TVOC" },
      "voc_index": { "name": "VOC index" },
