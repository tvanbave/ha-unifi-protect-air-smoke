{
  "config": {
    "step": {
      "user": {
        "title": "Connect to UniFi Protect",
        "description": "Use a local UniFi OS account (not a Ubiquiti cloud login) that can view Protect devices. The integration only reads data.",
        "data": {
          "host": "Host",
          "port": "Port",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
